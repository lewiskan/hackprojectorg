= doctype html
html lang={{.Site.LanguageCode}}
  head 
    {{partial "meta.html" .}}
    title {{.Site.Title}}
    {{partial "css.includes.html" .}}
    {{partial "js.includes.html" .}}
  body
    {{partial "navbar.html" .}}
    .container-fluid
      .row
        .jumbotron.text-center
          #img.img-responsive.pull-left src={{.Site.Params.assets.logo}} 
          h1 {{.Site.Title}}
          p {{.Site.Params.tagline}}
      .hero-bar 
        .container style="text-align: center;"
          .row 
            .col-sm-3
              h4 Propose a Project
              a.btn.btn-success href=docs/propose/proposeproject Propose Project
            .col-sm-3
              h4 Find a Project
              a.btn.btn-success href=docs/project/projects Projects
            .col-sm-3
              h4 Learn skills for Project
              a.btn.btn-success href=docs/learn/learnskills Learn
            .col-sm-3
              h4 Project Solutions
              a.btn.btn-success href=docs/solution/projectsolutions Solutions
      .landing-feature-2
        .container style="text-align: center;"
          .row
            .col-sm-12
              h1 Join us on Slack
          .row
            .col-sm-12
            a.btn.btn-info href=https://hackprojectorg.slack.com/messages/general/ HackProject.org on Slack 
          .row
            .col-sm-12
              h1 What is HackProject.org?
          .row
            .col-sm-3
              h3  Real-world projects 
              p Bridge the gap between hacking for fun and hacking for purpose with actual projects proposed with real-world limitations and use cases.
            .col-sm-3
              h3 Find a Project
              p Select a project that fits your current expertise, or choose a new challenge and learn new skills.
            .col-sm-3
              h3 Learn or Teach skills needed
              p Learn programming, mechanical, design, or other skills by joining the HackProject.org community.
            .col-sm-3
              h3 Share and improve on solution implementations
              p Solutions are current implementations that can always be improved or modified for new use cases.  
      .landing-feature-1
        .container style="text-align: center;"
          .row 
            .col-sm-12
              h2 HackProject.org is in Beta
              p Join the community by learning, teaching, and sharing!
      .landing-feature-1
        .container style="text-align: center;"
          .row 
            .col-sm-12
              h2 About HackProject.org
              a href=docs/contributors/about About HackProject.org
          .row 
            .col-sm-12
              a href=docs/contributors/supporters Support HackProject.org
    .footer
      .container
        .row
          .col-lg-12
            .text-muted 
              p © 2016 HackProject.org





